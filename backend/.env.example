# Copy to backend/.env and fill in. Nothing here has a hardcoded default secret --
# the app reads all of this from the environment (see app/config.py).

# --- Flask ---
SECRET_KEY=change-me
FLASK_DEBUG=1
PORT=5000
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Defaults to a local SQLite file at backend/instance/agentic_chat.db if unset.
# DATABASE_URL=sqlite:////absolute/path/to/db.sqlite

# --- LLM provider (required for the AI assistant to answer questions) ---
# AI_PROVIDER=openai            # "openai" or "anthropic"
# AI_API_KEY=sk-...             # or set OPENAI_API_KEY / ANTHROPIC_API_KEY instead
# AI_MODEL=gpt-4.1-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_SECONDS=60

# --- Text-to-speech (optional; gTTS is used by default and needs no key) ---
# TTS_PROVIDER=gtts             # "gtts" (default, free, no key) or "sarvam"
# SARVAM_API_KEY=
# SARVAM_TTS_SPEAKER=meera
# SARVAM_TTS_LANGUAGE=en-IN

SQL_ROW_LIMIT=200
